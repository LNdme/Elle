# Copiez ce fichier en ".env" et remplissez-le.

# --- elle-mcp-server (les agents y passent pour lire/écrire dans Elle) ---
ELLE_MCP_URL=http://localhost:3001/mcp

# --- Modèle : "ollama" | "anthropic" | "gemini" | "groq" | "deepseek" | "openrouter" ---
ELLE_MODEL_PROVIDER=openrouter

# Utilisé seulement si ELLE_MODEL_PROVIDER=ollama
# Le modèle DOIT supporter le tool calling (vérifiez avec : ollama show <modele>)
OLLAMA_API_BASE=http://localhost:11434
ELLE_OLLAMA_MODEL=qwen2.5:7b-instruct

# Utilisé seulement si ELLE_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ELLE_ANTHROPIC_MODEL=claude-sonnet-4-6

# Utilisé seulement si ELLE_MODEL_PROVIDER=groq
# Générez une clé sur https://console.groq.com (Settings > API Keys).
# Vérifiez le nom exact du modèle dans la console : le catalogue Groq
# change souvent, et le modèle doit supporter le tool calling.
GROQ_API_KEY=
ELLE_GROQ_MODEL=compound

# Utilisé seulement si ELLE_MODEL_PROVIDER=gemini
GOOGLE_API_KEY=
ELLE_GEMINI_MODEL=gemini-2.5-flash

# Utilisé seulement si ELLE_MODEL_PROVIDER=deepseek
# IMPORTANT : deepseek-chat / deepseek-reasoner sont retirés le 24 juillet
# 2026 (15:59 UTC) — utilisez les noms canoniques ci-dessous, pas les
# anciens alias, même si vous les voyez encore dans d'anciens tutoriels.
DEEPSEEK_API_KEY=
ELLE_DEEPSEEK_MODEL=deepseek-v4-flash

# Utilisé seulement si ELLE_MODEL_PROVIDER=openrouter
# Générez une clé sur https://openrouter.ai/keys
# Deux modèles gratuits en fallback : Nemotron-3-ultra (principal)
# puis GLM-5.2 (secours). Si le premier échoue (rate limit, erreur),
# LiteLLM bascule automatiquement sur le second.
OPENROUTER_API_KEY=
ELLE_OPENROUTER_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b:free
ELLE_OPENROUTER_FALLBACK_MODEL=z-ai/glm-5.2:free

# --- Recherche web (agents blog / notes-cours / création-cours) ---
# Service SÉPARÉ de l'inférence : nécessite un compte Ollama et sa propre
# clé API, même si ELLE_MODEL_PROVIDER n'est pas "ollama". Créez la clé
# sur https://ollama.com (compte > API keys). Sans cette variable, les
# agents fonctionnent normalement mais web_search/web_fetch échouent
# proprement (message d'erreur clair, pas de crash).
OLLAMA_API_KEY=

# --- Service HTTP de ce service (agents) ---
ELLE_AGENTS_PORT=8001

# Copiez ce fichier en ".env" et remplissez-le.

# --- Elle (le serveur Node) ---
ELLE_BASE_URL=http://localhost:3000
# Doit être IDENTIQUE au ELLE_AGENT_TOKEN utilisé pour lancer server.js
# ET au même utilisé dans elle-agents/.env.
ELLE_AGENT_TOKEN=change-moi

# --- Ce serveur MCP ---
MCP_PORT=3001
# 127.0.0.1 = accessible seulement depuis cet appareil (recommandé).
# Pour le rendre joignable depuis une autre machine du réseau local
# (ex. si Ollama/le service agents tourne ailleurs), passez à 0.0.0.0
# et consultez le README avant.
MCP_HOST=127.0.0.1
